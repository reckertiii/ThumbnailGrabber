# Copy to .env and fill in. The .env file is gitignored.
#
# Video source for the analyzer. Accepts:
#   - an RTSP URL:  rtsp://<user>:<pass>@<ip>:554/media/video1
#   - a webcam index: 0
#   - a path to an MP4 file
TG_STREAM_SOURCE=rtsp://user:password@192.168.1.100:554/media/video1

# Where captures are written.
#TG_OUTPUT_DIR=C:\Users\you\Pictures\ThumbnailGrabber

# Directories the web UI may read videos from, separated by the OS path separator
# (';' on Windows, ':' on Linux). Leave unset to allow any readable path, which is
# the historical behaviour. Set it if the port is reachable by anyone you don't
# trust: the web endpoints have no authentication.
#TG_VIDEO_ROOTS=/mnt/tank/media/sermons

# Largest video upload accepted by the web UI, in MB.
#TG_MAX_UPLOAD_MB=4096

# Where downloaded ML weights live (read-only) and where user ratings persist.
# The Docker image sets these; you normally don't need them for a local run.
#TG_MODELS_DIR=/opt/tg-models
#TG_DATA_DIR=/app/models

# AI judge. With a key set, a vision model reviews each candidate capture and its
# verdict is blended into the score. Leave unset to run on heuristics only.
#ANTHROPIC_API_KEY=sk-ant-...

# Self-hosted judge instead of (or as fallback to) the Claude API. Needs an Ollama
# server with a vision model pulled: `ollama pull qwen3-vl:4b`. No key, no per-call
# cost, nothing leaves your network; slower and a bit blunter than Claude.
#OLLAMA_HOST=http://localhost:11434
# qwen3-vl:4b for a modest box; qwen3-vl:30b (mixture-of-experts, ~20 GB RAM) runs
# about as fast on CPU with far better judgment. Avoid the -thinking tags here.
#TG_AI_JUDGE_OLLAMA_MODEL=qwen3-vl:30b
# Keep the model resident between reviews when RAM is dedicated to it (-1 = never unload).
#TG_AI_JUDGE_OLLAMA_KEEP_ALIVE=-1
# Match this to the container's CPU limit, or Ollama overruns it and gets throttled.
#TG_AI_JUDGE_OLLAMA_NUM_THREAD=20
# auto (default) | anthropic | ollama | off
#TG_AI_JUDGE_BACKEND=auto
