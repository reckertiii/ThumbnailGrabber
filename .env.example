# Copy to .env and fill in. The .env file is gitignored.
#
# Video source for the analyzer. Accepts:
#   - empty ("") to configure the camera from the Web UI instead
#   - an RTSP URL:  rtsp://<user>:<pass>@<ip>:554/media/video1
#   - a webcam index: 0
#   - a path to an MP4 file
TG_STREAM_SOURCE=

# Where captures are written.
#TG_OUTPUT_DIR=C:\Users\you\Pictures\ThumbnailGrabber

# Directories the web UI may browse for output or read videos from, separated by the
# OS path separator (';' on Windows, ':' on Linux). Leave unset to allow any readable path.
#TG_OUTPUT_ROOTS=/mnt/Main/captures
#TG_VIDEO_ROOTS=/mnt/Main/sermons

# Largest video upload accepted by the web UI, in MB.
#TG_MAX_UPLOAD_MB=4096

# Optional HTTP Basic Auth password for the web UI and API (leave empty on trusted LAN).
#TG_WEB_PASSWORD=

# Automatically stop live capture after this many minutes so capture never runs all week
# if someone forgets to click Stop (0 = no time limit).
#TG_CAPTURE_MAX_MINUTES=120

# Zero-CPU Idle Standby: pause CV inference & free DVR RAM when no browser is open and
# capture is stopped, waking automatically in <50 ms when opened or started (1 = enabled).
#TG_IDLE_STANDBY=1

# Where downloaded ML weights live (read-only) and where user ratings/settings persist.
# The Docker image sets these; you normally don't need them for a local run.
#TG_MODELS_DIR=/opt/tg-models
#TG_DATA_DIR=/app/models

# AI judge. With a key set, a vision model reviews each candidate capture and its
# verdict is blended into the score. Leave unset to run on heuristics or Ollama.
#ANTHROPIC_API_KEY=sk-ant-...
#TG_AI_JUDGE_MODEL=claude-sonnet-4-6

# Self-hosted judge instead of (or as fallback to) the Claude API. Needs an Ollama
# server with a vision model pulled: `ollama pull qwen3-vl:4b`. No key, no per-call
# cost, nothing leaves your network.
#OLLAMA_HOST=http://localhost:11434
# qwen3-vl:4b for a modest box; qwen3-vl:30b (mixture-of-experts, ~20 GB RAM) runs
# about as fast on CPU with far better judgment. Avoid the -thinking tags here.
#TG_AI_JUDGE_OLLAMA_MODEL=qwen3-vl:30b
# Keep the model resident between reviews when RAM is dedicated to it (-1 = never unload).
#TG_AI_JUDGE_OLLAMA_KEEP_ALIVE=30m
# Match this to the container's CPU limit, or Ollama overruns it and gets throttled.
#TG_AI_JUDGE_OLLAMA_NUM_THREAD=20
# auto (default) | anthropic | ollama | off
#TG_AI_JUDGE_BACKEND=auto

# Active window when woken on Start Capture (0 = no window).
#TG_AI_JUDGE_ACTIVE_HOURS=2
# Side-by-side contact-sheet "Tournament Finals" pass across top captures (1 = enabled).
#TG_AI_JUDGE_FINALS=1
# Distill AI Judge verdicts into the fast local ML preference model at 0.35x weight (1 = enabled).
#TG_AI_JUDGE_DISTILL=1

# Rolling Time-Machine RAM replay buffer in seconds (up to 180s) & burst filmstrip radius.
#TG_DVR_BUFFER_SECONDS=5
#TG_DVR_JPEG_COMPRESSION=1
#TG_BURST_FILMSTRIP_FRAMES=15

# Expression "Mood Buckets" diversity slots (warm_smile, passionate, calm_portrait, prop).
#TG_MOOD_BUCKETS=1

# Studio finishing options (can also be toggled live in the Web UI).
#TG_BROADCAST_POLISH=0
#TG_AUTO_CUTOUT=0
#TG_UPSCALE_4K=0

# Audio-aware speech-pause / laughter gating & local faster-whisper model for Sermon Titles.
#TG_AUDIO_GATING=0
#TG_WHISPER_MODEL=base.en

# Multi-worker parallel offline video scanner (0 = auto-detect CPU workers).
#TG_SCAN_WORKERS=0
